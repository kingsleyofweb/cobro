# =============================================================================
# Cobro Frontend (Next.js) — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# URL of the Cobro backend.
# Local dev:   http://localhost:4000
# Production:  https://your-backend-domain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# =============================================================================
# WALLETCONNECT (optional — for mobile wallet support)
# Get a free project ID at https://cloud.walletconnect.com
# Without this, only browser extension wallets (MetaMask etc.) work.
# =============================================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# CHAIN DISPLAY HINT (informational only — chain is always Celo Mainnet 42220)
# =============================================================================
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_CHAIN_NAME=Celo Mainnet
NEXT_PUBLIC_CHAIN_EXPLORER=https://celoscan.io
