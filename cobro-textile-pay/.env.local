# Cobro Frontend — Testnet Environment
# Targets Celo Alfajores (Sepolia) — matches your faucet CELO & USDC

# Set to "true" → targets Celo Sepolia (testnet), your faucet wallet
# Set to "false" or remove → targets Celo Mainnet (42220) for production
NEXT_PUBLIC_CELO_TESTNET=true

# Chain ID override — Celo Sepolia = 44787
# (Textile calls still use mainnet 42220 for live rates)
NEXT_PUBLIC_CELO_CHAIN_ID=44787

# Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
