# =============================================================================
# Cobro Backend — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Server port
PORT=4000

# Allowed frontend origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000

# =============================================================================
# TEXTILE FX API KEY  — required for live market rates
# Get yours at: https://docs.textilecredit.com/api/how-to-get-an-api-key
# or email: contact@textilecredit.com (mention the Celo hackathon)
#
# Without this key: simulated rates (still works for demo)
# With this key:    real 60s firm quotes from Textile's market makers
# =============================================================================
TEXTILE_API_KEY=

# =============================================================================
# AGENT PRIVATE KEY — your Celo wallet private key
#
# How to generate a fresh one:
#   node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom();
#            console.log('Address:',w.address); console.log('Key:',w.privateKey)"
#
# IMPORTANT: Fund this wallet with:
#   - CELO for gas  (~0.1 CELO, get from faucet.celo.org or any exchange)
#   - USDT or USDC  (the token the agent will use to pay invoices)
#     Celo USDT: 0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
#     Celo USDC: 0xcebA9300f2b948710d2653dD7B07f33A8B32118C
#
# MODES:
#   AGENT_PRIVATE_KEY set   → 🔴 LIVE:      agent signs both Textile txns autonomously
#   AGENT_PRIVATE_KEY empty → 🟠 ASSISTED:  client's MetaMask signs Textile txns
#   Both empty              → 🟡 SIMULATION: fake txHash (dev/demo)
#
# NOTE: No custom smart contract needed. Textile delivers cNGN directly
# to the freelancer's address via the `recipient` field in the RFQ request.
# =============================================================================
AGENT_PRIVATE_KEY=

# Public frontend URL advertised in the ERC-8004 registration file.
# Example: https://cobro.vercel.app
AGENT_PUBLIC_URL=

# Optional separate public backend URL. If omitted, the frontend URL is used.
# Example: https://cobro-api.onrender.com
AGENT_API_URL=

# =============================================================================
# CELO RPC ENDPOINT
# Free public node (fine for hackathon):
CELO_RPC_URL=https://forno.celo.org
#
# Premium options for high-traffic production:
#   Infura:  https://celo-mainnet.infura.io/v3/YOUR_INFURA_KEY
#   Alchemy: https://celo-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
#   Ankr:    https://rpc.ankr.com/celo
# =============================================================================

# =============================================================================
# ON-CHAIN REFERENCE — Celo Mainnet (chainId 42220)
# These are hardcoded in src/config/celo.ts. Listed here for reference only.
#
# Textile LimitOrderReactor: 0xa9AA0a64769cBed4d3B1Ceb4Df01CdE915C235b3
# Permit2:                   0x000000000022D473030F116dDEE9F6B43aC78BA3
# USDT (Celo):               0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
# USDC (native Celo):        0xcebA9300f2b948710d2653dD7B07f33A8B32118C
# cNGN:                      0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f
# =============================================================================
